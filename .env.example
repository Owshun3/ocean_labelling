# Copier ce fichier en .env et renseigner les valeurs avant docker compose up.
# Ce fichier EST commité — ne jamais y mettre de vraies valeurs.

# --- PostgreSQL ---
POSTGRES_PASSWORD=changeme

# --- Compte admin CVAT (utilisé par app-api pour lister tous les utilisateurs) ---
# Doit correspondre au superuser créé dans CVAT au premier démarrage.
CVAT_ADMIN_USER=admin
CVAT_ADMIN_PASS=changeme

# --- Origines acceptées par CVAT (CSRF) ---
# Laisser vide ou commenté en dev local : docker-compose.yml utilise un défaut localhost.
# Sur la VM, décommenter et lister les origines (Expo Metro 8081 + gateway 8888).
# Format : URL séparées par des virgules, sans espaces.
# Exemple :
#   CSRF_TRUSTED_ORIGINS=http://10.20.30.40:8081,http://10.20.30.40:8888,https://annot.univ.fr

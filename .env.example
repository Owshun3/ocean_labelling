# Copier ce fichier en .env et renseigner les valeurs avant docker compose up.
# Ce fichier EST commité — ne jamais y mettre de vraies valeurs.

# --- PostgreSQL ---
POSTGRES_PASSWORD=changeme

# --- Compte admin CVAT (utilisé par app-api pour lister tous les utilisateurs) ---
# Doit correspondre au superuser créé dans CVAT au premier démarrage.
CVAT_ADMIN_USER=admin
CVAT_ADMIN_PASS=changeme

# Copier ce fichier en .env et renseigner les valeurs avant npx expo start.
# Ce fichier EST commité — ne jamais y mettre de vraies valeurs.

# URL de base de l'API CVAT (via gateway NGINX)
EXPO_PUBLIC_API_URL=http://localhost:8888/api

# URL de base de l'app-api (RBAC)
EXPO_PUBLIC_APP_API_URL=http://localhost:8888/app-api

# URL du gateway pour ouvrir le studio d'annotation CVAT
EXPO_PUBLIC_CVAT_UI_URL=http://localhost:8888

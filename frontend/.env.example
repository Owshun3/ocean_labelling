# Les URLs de l'API sont desormais derivees au runtime depuis window.location
# (voir src/services/api/runtimeUrls.ts). Le bundle Expo n'a plus besoin
# d'etre rebuild pour basculer entre localhost, IP LAN ou https://otf.upf.pf.
#
# Override possible (rare, pour cas particuliers type tunnel ngrok / dev
# distribue) :
#   EXPO_PUBLIC_APP_API_URL=https://mon-tunnel.example.com/app-api
#
# Copier ce fichier en .env si tu veux poser un override. Sinon ne rien creer.
